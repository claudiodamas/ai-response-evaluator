# Configuração de Chaves de API para LLM-as-a-Judge

# Google Gemini API Key (Recomendado)
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (Opcional)
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Provedor ativo: 'gemini' ou 'openai'
LLM_PROVIDER=gemini

